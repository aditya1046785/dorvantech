# Runtime Prisma defaults: connection_limit=3, connect_timeout=10, pool_timeout=20.
# Explicit URL parameters override these defaults; DATABASE_URL remains the migration URL.
DATABASE_URL_POOLED="postgresql://USER:PASSWORD@POOL_HOST:5432/postgres?sslmode=require"
DATABASE_URL="postgresql://USER:PASSWORD@DIRECT_HOST:5432/postgres?sslmode=require"
NEXT_PUBLIC_SITE_URL="http://localhost:3000"
AUTH_ENCRYPTION_KEY=""

# Recruitment: keep disabled until migrations, storage, scanner and email are verified.
APPLICATIONS_ENABLED="false"
# Private Vercel Blob store; server-only credentials (never NEXT_PUBLIC_).
BLOB_READ_WRITE_TOKEN=""
BLOB_STORE_ID=""
RESEND_API_KEY=""
APPLICATION_FROM_EMAIL=""
APPLICATION_REPLY_TO=""
# Random secret for the scheduled recruitment job endpoint; at least 32 random bytes.
RECRUITMENT_JOBS_SECRET=""
# Signing secret from the Resend webhook configuration (whsec_...).
RESEND_WEBHOOK_SECRET=""

# Cloudmersive Virus Scan API key (server-only).
CLOUDMERSIVE_API_KEY=""
